{
  "description": "Full 6-stage ML pipeline configuration for Nizhnesvirsky region",
  "dry_run": false,
  "auto_apply_feedback": false,

  "stage0_env_check": {
    "output_dir": "outputs/20260307",
    "min_free_disk_gb": 10.0,
    "min_python": [3, 9],
    "required_packages": ["torch", "rasterio", "boto3", "numpy", "pandas"],
    "s3_endpoint": "https://s3.waw3-1.cloudferro.com",
    "sentinelhub_config": ""
  },

  "global": {
    "project_root": "/Users/rv/Desktop/SAR/sar",
    "output_base": "outputs",
    "timestamp": "20260307"
  },
  
  "stage1_download": {
    "bbox": [28.0, 60.0, 32.0, 62.0],
    "date_range": ["2022-11-01", "2023-12-31"],
    "sensor": "sentinel-1",
    "output_dir": "outputs/20260307",
    "max_items": 10,
    "skip_existing": true
  },
  
  "stage2_enrichment": {
    "input_dir": "metadata_by_item",
    "output_dir": "metadata_by_item",
    "s3_prefix": "s3://eodata/Sentinel-1/",
    "try_s3_discovery": true,
    "stac_token": null,
    "limit": 0
  },
  
  "stage3_goal_enrichment": {
    "input_dir": "metadata_by_item",
    "output_dir": "model/inputs/goal_specific",
    "goal": "all",
    "catalog_path": "model/ml_tuned_catalog.json",
    "parameter_selection": "model/parameterSelection-UnSupervised-Geographical.json",
    "train_type": "unsupervised",
    "suitability_thresholds": {}
  },
  
  "stage4_data_prep": {
    "input_dir": "model/inputs/goal_specific",
    "output_dir": "outputs/20260307",
    "chip_size": 512,
    "batch_size": 4,
    "random_seed": 42,
    "train_val_test_split": [0.7, 0.2, 0.1],
    "max_chips_per_scene": 10,
    "nan_tolerance": 0.2
  },
  
  "stage5_training": {
    "input_dir": "outputs/20260307",
    "output_dir": "outputs/20260307/models",
    "model_type": "unsupervised",
    "goal": "geographical",
    "architecture": "vit-mae",
    "hyperparameters": {
      "epochs": 10,
      "learning_rate": 0.0001,
      "batch_size": 4,
      "optimizer": "AdamW",
      "loss_function": "MSE"
    },
    "random_seed": 42,
    "checkpoint_every_n_epochs": 5,
    "parameter_selection": "model/parameterSelection-UnSupervised-Geographical.json"
  },
  
  "stage6_feedback": {
    "model_report": "outputs/20260307/models/training_report.json",
    "validation_metrics": "outputs/20260307/validation_metrics.json",
    "output_dir": "outputs/20260307",
    "current_configs_dir": "configs",
    "recommendation_threshold": 0.7,
    "rejection_rate_threshold": 0.8
  }
}
